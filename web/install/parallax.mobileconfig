<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Profil de configuration Parallax — Web Clip.

  Ce que fait ce profil : il pose une icône « Parallax » sur l'écran d'accueil
  qui ouvre la page d'installation en plein écran, comme une app. De là, on
  installe l'IPA via son propre signeur (SideStore / AltStore) en un tap.

  Il NE fait rien d'autre : aucun DNS, aucun VPN, aucune collecte, aucun
  routage. Retirable à tout moment depuis Réglages > Général > VPN et gestion
  de l'appareil.

  NON SIGNÉ : iOS l'affichera comme « non vérifié » à l'installation. Le signer
  demanderait un certificat de distribution, la même contrainte que pour l'IPA.
-->
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key><string>com.apple.webClip.managed</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadIdentifier</key><string>io.parallax.webclip</string>
      <key>PayloadUUID</key><string>7F2A9C10-1B44-4E7A-9C21-1A2B3C4D5E01</string>
      <key>PayloadDisplayName</key><string>Parallax sur l'écran d'accueil</string>
      <key>URL</key><string>https://zayfway.github.io/parallax/install/</string>
      <key>Label</key><string>Parallax</string>
      <key>IsRemovable</key><true/>
      <key>FullScreen</key><true/>
      <key>Icon</key>
